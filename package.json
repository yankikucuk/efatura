{
  "name": "@yankikucuk/efatura",
  "version": "1.0.0",
  "description": "GİB e-Arşiv Portalı için sıfır bağımlılıklı TypeScript istemcisi — fatura, müstahsil makbuzu ve serbest meslek makbuzu",
  "keywords": [
    "efatura",
    "e-fatura",
    "earsiv",
    "e-arsiv",
    "e-arşiv",
    "earsivportal",
    "fatura",
    "gib",
    "e-belge",
    "ebelge",
    "ubl-tr",
    "e-invoice",
    "einvoice",
    "invoice",
    "invoicing",
    "turkey",
    "turkish",
    "vergi",
    "mukellef",
    "nodejs",
    "makbuz",
    "mustahsil",
    "mustahsil-makbuzu",
    "e-mustahsil",
    "serbest-meslek",
    "serbest-meslek-makbuzu",
    "e-smm",
    "stopaj",
    "tevkifat",
    "kdv",
    "fatura-kesme"
  ],
  "license": "MIT",
  "author": "Yankı Küçük",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yankikucuk/efatura.git"
  },
  "bugs": {
    "url": "https://github.com/yankikucuk/efatura/issues"
  },
  "homepage": "https://github.com/yankikucuk/efatura#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:publish": "publint",
    "check:types": "attw --pack .",
    "prepublishOnly": "npm run build",
    "prepare": "simple-git-hooks >/dev/null 2>&1 || true"
  },
  "dependencies": {},
  "peerDependencies": {
    "puppeteer": ">=22"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "knip": "6.34.0",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "simple-git-hooks": "2.14.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml}": "prettier --write",
    "*.ts": "eslint --fix"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
