{
  "name": "efatura",
  "version": "1.0.0",
  "description": "GİB e-Arşiv Portalı için sıfır bağımlılıklı TypeScript istemcisi",
  "keywords": [
    "efatura",
    "e-fatura",
    "earsiv",
    "e-arsiv",
    "e-arşiv",
    "earsivportal",
    "fatura",
    "gib",
    "e-belge",
    "ebelge",
    "ubl-tr",
    "e-invoice",
    "einvoice",
    "invoice",
    "invoicing",
    "turkey",
    "turkish",
    "vergi",
    "mukellef",
    "nodejs"
  ],
  "license": "MIT",
  "author": "Yankı Küçük",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yankikucuk/efatura.git"
  },
  "bugs": {
    "url": "https://github.com/yankikucuk/efatura/issues"
  },
  "homepage": "https://github.com/yankikucuk/efatura#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:publish": "publint",
    "check:types": "attw --pack .",
    "prepublishOnly": "npm run build",
    "prepare": "simple-git-hooks >/dev/null 2>&1 || true"
  },
  "peerDependencies": {
    "puppeteer": ">=22"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "9.36.0",
    "@types/node": "22.18.1",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.16.1",
    "knip": "5.64.0",
    "lint-staged": "16.2.0",
    "prettier": "3.6.2",
    "publint": "0.3.12",
    "simple-git-hooks": "2.13.1",
    "tsup": "8.5.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.0",
    "vitest": "3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml}": "prettier --write",
    "*.ts": "eslint --fix"
  }
}
